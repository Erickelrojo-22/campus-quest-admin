# APP_ENV=production
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://campus.tu-dominio.edu

# create-admin puede leer ADMIN_EMAIL/ADMIN_PASSWORD, pero se recomienda
# introducir la contraseña interactivamente para no guardarla en archivos.
