# Ejecuta los comandos Python desde la raíz del repositorio.
APP_ENV=development
DATABASE_URL=sqlite:///./data/campus_quest.db
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST_DIR=frontend/dist

# Solo para el perfil production de Docker Compose + Caddy.
