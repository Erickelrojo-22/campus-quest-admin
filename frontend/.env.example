# api: servidor FastAPI real; demo: catálogo + usuarios ficticios en memoria.
VITE_DATA_MODE=api
# Mismo origen. Vite reenvía /api al backend durante el desarrollo.
VITE_API_BASE_URL=/api/v1
# Solo desarrollo (variable del proceso Vite, no se envía al navegador).
API_PROXY_TARGET=http://127.0.0.1:8000
# Opcional: origen HTTPS público para metadatos de enlaces compartidos.
# VITE_SITE_ORIGIN=https://campus.tu-dominio.edu

# Vercel: variable de servidor para api/proxy.js; NO usar prefijo VITE_.
# BACKEND_URL=https://tu-backend.up.railway.app
# Vercel: enlace público a Swagger (el proxy solo reenvía /api/v1).
# VITE_API_DOCS_URL=https://tu-backend.up.railway.app/docs
